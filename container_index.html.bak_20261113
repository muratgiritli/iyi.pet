  <title>Atakum Pet | Toptan Mama, enuygun.pet Çeşidi</title>
  <meta name="description" content="Atakum Pet: Atakum’daki en geniş çeşit enuygun.pet reyonudur. Mamalar toptan fiyatla. WhatsApp 0542 462 29 59, her gün 09:00–21:00." />
  <link rel="canonical" href="https://www.atakumpet.com/" />
  <link rel="alternate" hreflang="tr" href="https://www.atakumpet.com/" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="theme-color" content="#1a365d" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy: #1a365d;
      --navy-deep: #122844;
      --gold: #d4a017;
      --gold-soft: #f0c14b;
      --cream: #f7f2e8;
      --muted: #eef2f6;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: Montserrat, system-ui, sans-serif; color: var(--navy); background: #fff; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    .wrap { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }

    header.top { position: sticky; top: 0; z-index: 80; background: #fff; border-bottom: 1px solid #eef1f5; }
    .top-inner { width: min(1160px, calc(100% - 32px)); margin: 0 auto; display: flex; align-items: center; gap: 16px; min-height: 76px; }
    .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .brand svg { width: 32px; height: 32px; }
    .brand-txt { display: flex; flex-direction: column; line-height: 1.05; }
    .brand-txt b { font-size: 15px; font-weight: 800; letter-spacing: .06em; color: var(--navy); }
    .brand-txt i { font-style: normal; font-size: 11px; font-weight: 700; letter-spacing: .12em; color: var(--gold); }
    nav.desk { display: flex; align-items: center; justify-content: center; gap: 18px; flex: 1; }
    nav.desk a { font-size: 11px; font-weight: 700; letter-spacing: .08em; color: var(--navy); }
    nav.desk a:hover { color: var(--gold); }
    .icons { display: flex; align-items: center; gap: 14px; margin-left: auto; }
    .icons a, .icons button { background: none; border: 0; padding: 0; cursor: pointer; color: var(--navy); display: grid; place-items: center; position: relative; }
    .icons svg { width: 21px; height: 21px; }
    .cart-badge { position: absolute; top: -7px; right: -8px; background: var(--gold); color: #fff; font-size: 9px; font-weight: 800; min-width: 15px; height: 15px; border-radius: 99px; display: grid; place-items: center; }
    .burger { display: none; }
    .search-bar { display: none; background: #fff; border-top: 1px solid #eef1f5; }
    .search-bar.open { display: block; }
    .search-bar form { width: min(1160px, calc(100% - 32px)); margin: 0 auto; padding: 12px 0 16px; display: flex; gap: 8px; }
    .search-bar input { flex: 1; border: 1px solid #d7dee8; border-radius: 10px; padding: 10px 14px; font: 600 14px Montserrat, sans-serif; color: var(--navy); }
    .search-bar button { background: var(--navy); color: #fff; border: 0; border-radius: 10px; padding: 10px 16px; font: 700 12px Montserrat, sans-serif; cursor: pointer; }

    .hero { background: var(--cream); overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; min-height: 500px; gap: 12px; }
    .hero-copy { padding: 48px 0 52px; }
    .hero h1 { font-size: clamp(32px, 4.4vw, 52px); font-weight: 900; line-height: .95; letter-spacing: -.02em; }
    .hero h1 .navy { color: var(--navy); display: block; }
    .hero h1 .gold { color: var(--gold); display: block; }
    .hero .lead { margin-top: 16px; max-width: 420px; font-size: 14px; font-weight: 600; line-height: 1.55; }
    .feats { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; margin-top: 26px; max-width: 500px; }
    .feat { text-align: center; }
    .feat .ic { width: 40px; height: 40px; margin: 0 auto 8px; border: 1.5px solid var(--navy); border-radius: 50%; display: grid; place-items: center; }
    .feat .ic svg { width: 17px; height: 17px; }
    .feat b { display: block; font-size: 10px; font-weight: 800; }
    .feat span { display: block; font-size: 10px; font-weight: 600; opacity: .8; margin-top: 2px; }
    .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
    .btn-wa { display: inline-flex; align-items: center; gap: 10px; background: var(--gold); color: #fff; font-size: 13px; font-weight: 800; letter-spacing: .04em; padding: 14px 22px; border-radius: 10px; box-shadow: 0 8px 18px rgba(212,160,23,.28); }
    .btn-wa:hover { filter: brightness(.95); }
    .btn-call { display: inline-flex; align-items: center; gap: 10px; background: #fff; color: var(--navy); border: 2px solid var(--navy); font-size: 13px; font-weight: 800; letter-spacing: .04em; padding: 12px 20px; border-radius: 10px; }
    .btn-call:hover { background: var(--navy); color: #fff; }
    .hero-art { position: relative; align-self: end; display: flex; justify-content: center; min-height: 420px; }
    .blob { position: absolute; border-radius: 50%; z-index: 0; }
    .blob-a { width: 280px; height: 280px; background: var(--gold-soft); top: 40px; right: 30px; }
    .blob-b { width: 180px; height: 180px; background: #e8a54a; bottom: 70px; right: 180px; opacity: .85; }
    .dots { position: absolute; top: 28px; right: 12px; width: 90px; height: 70px; background-image: radial-gradient(#9aa7b8 1.4px, transparent 1.5px); background-size: 10px 10px; z-index: 0; }
    .hero-art img { position: relative; z-index: 1; width: min(520px, 100%); height: auto; object-fit: contain; }

    .cats { padding: 28px 0 8px; }
    .cat-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 16px; }
    .cat { border-radius: 16px; padding: 22px 18px 20px; min-height: 168px; }
    .cat svg { width: 36px; height: 36px; margin-bottom: 12px; }
    .cat h3 { font-size: 16px; font-weight: 800; letter-spacing: .06em; margin-bottom: 6px; }
    .cat p { font-size: 12px; font-weight: 600; line-height: 1.45; opacity: .8; }
    .c-kedi { background: #f8e6d4; }
    .c-kopek { background: #e4eaf1; }
    .c-kus { background: #e4f0e6; }
    .c-akvaryum { background: #dceaf4; }

    .banner { background: var(--navy-deep); color: #fff; margin-top: 28px; }
    .banner-inner { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; padding: 28px 0 22px; }
    .banner h2 { font-size: clamp(18px, 2.4vw, 26px); font-weight: 800; letter-spacing: .02em; }
    .banner h2 .gold { color: var(--gold-soft); }
    .banner svg.scooter { width: 72px; height: 72px; }
    .pills { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 0 22px; }
    .pill { display: inline-flex; align-items: center; gap: 6px; background: #1c3d63; color: #fff; border-radius: 999px; padding: 7px 12px; font-size: 11px; font-weight: 700; letter-spacing: .03em; }
    .pill svg { width: 12px; height: 12px; color: var(--gold-soft); }

    .contact-wrap { padding: 48px 0 36px; }
    .contact-wrap h2 { text-align: center; font-size: 22px; font-weight: 800; letter-spacing: .04em; }
    .gold-line { width: 72px; height: 3px; background: var(--gold); margin: 10px auto 28px; border-radius: 99px; }
    .contact-card { display: grid; grid-template-columns: .85fr 1.15fr; gap: 24px; align-items: stretch; }
    .rows { display: grid; gap: 16px; padding-top: 8px; }
    .row { display: flex; align-items: flex-start; gap: 12px; font-size: 14px; font-weight: 600; line-height: 1.45; }
    .row .dot { width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; background: var(--navy); color: #fff; display: grid; place-items: center; }
    .row .dot svg { width: 14px; height: 14px; }
    .map-box { position: relative; min-height: 280px; background: #d7e3ea; border-radius: 12px; overflow: hidden; }
    .map-box iframe { width: 100%; height: 100%; min-height: 280px; border: 0; pointer-events: none; }
    .map-hit { position: absolute; inset: 0; z-index: 2; }
    .map-pin { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -70%); z-index: 3; pointer-events: none; text-align: center; }
    .pin-mark { width: 48px; height: 48px; margin: 0 auto 8px; background: var(--navy); color: #fff; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); display: grid; place-items: center; box-shadow: 0 10px 20px rgba(26,54,93,.28); }
    .pin-mark svg { width: 20px; height: 20px; transform: rotate(45deg); }
    .pin-label { background: #fff; padding: 8px 12px; border-radius: 8px; box-shadow: 0 8px 20px rgba(26,54,93,.16); min-width: 170px; }
    .pin-label b { display: block; font-size: 12px; }
    .pin-label span { display: block; font-size: 10px; font-weight: 600; margin-top: 3px; opacity: .8; }

    .values { padding: 8px 0 32px; }
    .value-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 18px; }
    .value { display: flex; gap: 12px; align-items: flex-start; }
    .value svg { width: 28px; height: 28px; color: var(--gold); flex-shrink: 0; margin-top: 2px; }
    .value b { display: block; font-size: 12px; font-weight: 800; letter-spacing: .02em; }
    .value span { display: block; font-size: 11px; font-weight: 600; margin-top: 4px; line-height: 1.4; opacity: .8; }

    footer.site { background: var(--navy-deep); color: #fff; padding: 22px 0; }
    .foot-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .foot-brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: .04em; font-size: 13px; }
    .foot-brand svg { width: 22px; height: 22px; }
    .foot-mid { font-size: 13px; font-weight: 600; }
    .social { display: flex; gap: 10px; }
    .social a { width: 34px; height: 34px; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; display: grid; place-items: center; color: #fff; }
    .social svg { width: 16px; height: 16px; }

    .drawer { display: none; position: fixed; inset: 0; z-index: 90; background: rgba(15,32,58,.45); }
    .drawer.open { display: block; }
    .drawer nav { position: absolute; top: 0; right: 0; width: min(320px, 88vw); height: 100%; background: #fff; padding: 28px 22px; display: flex; flex-direction: column; gap: 16px; }
    .drawer nav a { font-weight: 700; font-size: 14px; letter-spacing: .04em; }

    @media (max-width: 980px) {
      nav.desk { display: none; }
      .burger { display: grid; }
      .hero-grid, .cat-grid, .contact-card, .value-grid, .banner-inner { grid-template-columns: 1fr; }
      .hero-copy { padding: 32px 0 8px; }
      .hero-art { min-height: 300px; }
      .foot-inner { flex-direction: column; text-align: center; }
      .feats { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 640px) {
      .ctas { flex-direction: column; }
      .btn-wa, .btn-call { justify-content: center; }
    }
  
    /* seo-enhance-css */
    .seo-more { margin-top: 1.35rem; }
    .seo-more h2 { font-size: 1.125rem; font-weight: 800; color: var(--navy); margin: 1.1rem 0 .55rem; }
    .seo-more h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin: .9rem 0 .4rem; }
    .seo-more p { margin: .45rem 0; line-height: 1.65; }
    .seo-more .faq details { border-top: 1px solid #edf0f4; padding: .65rem 0; }
    .seo-more .faq summary { font-weight: 700; cursor: pointer; color: var(--navy); }
    .seo-more .faq details p { margin-top: .4rem; color: #374151; }
    .home-seo { background: #f4efe4; padding: 2.4rem 0 2.8rem; }
    .home-seo h2 { font-size: 1.35rem; font-weight: 800; color: var(--navy); margin-bottom: .8rem; }
    .home-seo h3 { font-size: 1.05rem; font-weight: 700; margin: 1rem 0 .4rem; color: var(--navy); }
    .home-seo p { line-height: 1.7; margin: .45rem 0; max-width: 72ch; }
    .home-seo details { background: #fff; border-radius: .7rem; padding: .75rem 1rem; margin: .45rem 0; }
    .home-seo summary { font-weight: 700; cursor: pointer; color: var(--navy); }

  </style>
