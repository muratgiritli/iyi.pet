  </div>
  <script>
    (function () {
      var searchBtn = document.getElementById("searchBtn");
      var searchBar = document.getElementById("searchBar");
      var searchInput = document.getElementById("searchInput");
      var searchHidden = document.getElementById("searchHidden");
      var menuBtn = document.getElementById("menuBtn");
      var drawer = document.getElementById("drawer");
      searchBtn.addEventListener("click", function () {
        searchBar.classList.toggle("open");
        if (searchBar.classList.contains("open")) searchInput.focus();
      });
      searchBar.querySelector("form").addEventListener("submit", function () {
        searchHidden.value = "site:atakumpet.com " + searchInput.value;
      });
      menuBtn.addEventListener("click", function () { drawer.classList.add("open"); });
      drawer.addEventListener("click", function (e) {
        if (e.target === drawer || e.target.tagName === "A") drawer.classList.remove("open");
      });
    })();
  </script>
