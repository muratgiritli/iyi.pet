  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&amp;family=Pacifico&amp;display=swap" rel="stylesheet" />
  <style>
    :root { --navy:#0b1d4a; --navy-2:#12275e; --yellow:#ffcc00; --gold:#ffb000; --ink:#0b1d4a; }
    * { box-sizing:border-box; margin:0; padding:0; }
    html { scroll-behavior:smooth; }
    body { font-family:Montserrat,system-ui,sans-serif; color:var(--ink); background:#f5f6f8; }
    a { color:inherit; text-decoration:none; }
    img { max-width:100%; display:block; }
    .wrap { width:min(1180px, calc(100% - 40px)); margin:0 auto; }

    header.top { position:sticky; top:0; z-index:80; background:var(--navy); color:#fff; }
    .top-inner { width:min(1180px, calc(100% - 24px)); margin:0 auto; display:flex; align-items:center; gap:14px; min-height:78px; }
    .brand { display:flex; align-items:center; gap:10px; flex-shrink:0; }
    .paw { width:38px; height:38px; border-radius:50%; background:var(--yellow); display:grid; place-items:center; }
    .paw svg { width:20px; height:20px; }
    .brand-txt b { display:block; font-size:15px; font-weight:900; letter-spacing:.04em; }
    .brand-txt b .y { color:var(--yellow); }
    .brand-txt i { display:block; font-family:Pacifico,cursive; font-style:normal; font-size:11px; font-weight:400; opacity:.9; margin-top:2px; }
    nav.desk { display:flex; align-items:center; justify-content:center; gap:12px; flex:1; flex-wrap:wrap; }
    nav.desk a { font-size:11px; font-weight:700; letter-spacing:.04em; display:flex; flex-direction:column; align-items:center; gap:3px; opacity:.95; }
    nav.desk a svg { width:18px; height:18px; }
    nav.desk a:hover { color:var(--yellow); }
    .icons { display:flex; align-items:center; gap:12px; margin-left:auto; }
    .icons a, .icons button { background:none; border:0; padding:0; cursor:pointer; color:var(--yellow); display:grid; place-items:center; position:relative; }
    .icons svg { width:20px; height:20px; }
    .cart-badge { position:absolute; top:-7px; right:-8px; background:var(--yellow); color:var(--navy); font-size:9px; font-weight:800; min-width:15px; height:15px; border-radius:99px; display:grid; place-items:center; }
    .burger { display:none; color:#fff; }
    .search-bar { display:none; background:#0a1738; }
    .search-bar.open { display:block; }
    .search-bar form { width:min(1180px, calc(100% - 24px)); margin:0 auto; padding:12px 0 16px; display:flex; gap:8px; }
    .search-bar input { flex:1; border:0; border-radius:10px; padding:10px 14px; font:600 14px Montserrat,sans-serif; }
    .search-bar button { background:var(--yellow); color:var(--navy); border:0; border-radius:10px; padding:10px 16px; font:800 12px Montserrat,sans-serif; cursor:pointer; }

    .hero { background:radial-gradient(circle at 80% 20%, #fff3c4 0 80px, transparent 81px), linear-gradient(#f7f8fb,#eef0f4); overflow:hidden; }
    .hero-grid { display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:8px; min-height:500px; }
    .hero-copy { padding:44px 0 36px; }
    .hero h1 { font-size:clamp(28px, 4.2vw, 48px); font-weight:900; line-height:.95; letter-spacing:-.03em; }
    .hero h1 .navy { display:block; }
    .hero h1 .gold { display:block; color:var(--gold); }
    .hero .lead { margin-top:14px; max-width:440px; font-size:13px; font-weight:600; line-height:1.55; }
    .feats { display:flex; flex-wrap:wrap; gap:14px 18px; margin-top:20px; }
    .feats span { display:inline-flex; align-items:center; gap:6px; font-size:10px; font-weight:800; letter-spacing:.03em; }
    .feats svg { width:16px; height:16px; color:var(--navy); }
    .ctas { display:flex; flex-wrap:wrap; gap:12px; margin-top:22px; }
    .btn-wa { display:inline-flex; align-items:center; gap:10px; background:var(--yellow); color:var(--navy); font-size:13px; font-weight:800; letter-spacing:.04em; padding:14px 22px; border-radius:12px; }
    .btn-call { display:inline-flex; align-items:center; gap:10px; background:var(--navy); color:#fff; font-size:13px; font-weight:800; letter-spacing:.04em; padding:14px 22px; border-radius:12px; }
    .hero-art { position:relative; min-height:400px; display:flex; align-items:flex-end; justify-content:center; }
    .hero-art img { width:min(520px,100%); }
    .badge { position:absolute; right:18px; bottom:48px; z-index:2; width:108px; height:108px; border-radius:50%; background:var(--navy); color:#fff; display:grid; place-items:center; text-align:center; padding:12px; font-size:11px; font-weight:800; line-height:1.25; }

    .cats { padding:28px 0 10px; }
    .cat-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:12px; }
    .cat { background:#fff; border-radius:16px; padding:16px 14px 18px; box-shadow:0 8px 20px rgba(11,29,74,.06); display:grid; grid-template-columns:auto 1fr; gap:10px; align-items:center; position:relative; min-height:118px; }
    .cat img { width:56px; height:56px; border-radius:50%; object-fit:cover; }
    .cat h3 { font-size:14px; font-weight:800; letter-spacing:.04em; }
    .c-kedi h3 { color:#e67e22; } .c-kopek h3 { color:#1a73e8; } .c-kus h3 { color:#2e8b57; }
    .c-tavsan h3 { color:#8e44ad; } .c-gine h3 { color:#c0392b; } .c-kap h3 { color:#16a085; }
    .cat p { font-size:11px; font-weight:600; color:#667; line-height:1.4; margin-top:4px; }
    .cat .go { position:absolute; right:10px; bottom:10px; width:26px; height:26px; border-radius:50%; background:var(--navy); color:#fff; display:grid; place-items:center; font-size:13px; }

    .banner { background:var(--navy); color:#fff; margin-top:28px; }
    .banner-inner { display:grid; grid-template-columns:1.15fr .85fr auto; gap:22px; align-items:center; padding:26px 0; }
    .ban-left { display:flex; align-items:center; gap:14px; }
    .ban-left h2 { font-size:clamp(16px,2.2vw,22px); font-weight:800; }
    .ban-left p { margin-top:6px; font-size:13px; font-weight:600; opacity:.9; }
    .zones { display:grid; grid-template-columns:1fr 1fr; gap:8px 16px; }
    .zones a { display:flex; align-items:center; gap:8px; font-size:12px; font-weight:700; }
    .zones svg { width:14px; height:14px; color:var(--yellow); }
    .same { width:92px; height:92px; border-radius:50%; background:var(--yellow); color:var(--navy); display:grid; place-items:center; text-align:center; font-size:10px; font-weight:900; line-height:1.25; padding:10px; }

    .contact-wrap { padding:46px 0 32px; background:#fff; }
    .contact-wrap h2 { font-size:22px; font-weight:800; margin-bottom:22px; }
    .contact-card { display:grid; grid-template-columns:.85fr 1.15fr; gap:24px; }
    .rows { display:grid; gap:16px; }
    .row { display:flex; align-items:flex-start; gap:12px; font-size:14px; font-weight:600; line-height:1.45; }
    .row .dot { width:32px; height:32px; border-radius:50%; background:var(--navy); color:var(--yellow); display:grid; place-items:center; flex-shrink:0; }
    .row .dot svg { width:15px; height:15px; }
    .map-box { position:relative; min-height:280px; background:#d7e3ea; border-radius:14px; overflow:hidden; }
    .map-box iframe { width:100%; height:100%; min-height:280px; border:0; pointer-events:none; }
    .map-hit { position:absolute; inset:0; z-index:2; }
    .map-pin { position:absolute; left:50%; top:42%; transform:translate(-50%,-70%); z-index:3; pointer-events:none; text-align:center; }
    .pin-mark { width:46px; height:46px; margin:0 auto 8px; background:var(--yellow); color:var(--navy); border-radius:50% 50% 50% 0; transform:rotate(-45deg); display:grid; place-items:center; }
    .pin-mark svg { width:18px; height:18px; transform:rotate(45deg); }
    .pin-label { background:#fff; padding:8px 12px; border-radius:8px; box-shadow:0 8px 20px rgba(11,29,74,.16); min-width:150px; }
    .pin-label b { display:block; font-size:12px; }
    .pin-label span { display:block; font-size:10px; font-weight:600; margin-top:3px; opacity:.8; }

    .values { background:#e8eef8; padding:22px 0; }
    .value-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
    .value { display:flex; gap:12px; align-items:flex-start; }
    .vico { width:36px; height:36px; border-radius:50%; background:var(--navy); color:var(--yellow); display:grid; place-items:center; flex-shrink:0; }
    .vico svg { width:18px; height:18px; }
    .value b { display:block; font-size:12px; font-weight:800; }
    .value span { display:block; font-size:11px; font-weight:600; margin-top:3px; opacity:.75; }

    footer.site { background:var(--navy); color:#fff; padding:22px 0; }
    .foot-inner { display:grid; grid-template-columns:1.1fr 1.5fr auto; align-items:center; gap:16px; }
    .foot-brand b { display:block; font-size:14px; letter-spacing:.05em; }
    .foot-brand span { display:block; font-size:12px; font-family:Pacifico,cursive; margin-top:3px; opacity:.9; }
    .foot-feats { display:flex; flex-wrap:wrap; gap:12px 16px; justify-content:center; font-size:10px; font-weight:700; }
    .social { display:flex; gap:10px; align-items:center; }
    .social em { font-style:normal; font-size:12px; font-weight:800; margin-right:4px; }
    .social a { width:34px; height:34px; border:1px solid rgba(255,255,255,.35); border-radius:50%; display:grid; place-items:center; color:#fff; }
    .social svg { width:16px; height:16px; }

    .drawer { display:none; position:fixed; inset:0; z-index:90; background:rgba(5,12,32,.5); }
    .drawer.open { display:block; }
    .drawer nav { position:absolute; top:0; right:0; width:min(320px,88vw); height:100%; background:#fff; padding:28px 22px; display:flex; flex-direction:column; gap:16px; }
    .drawer nav a { font-weight:800; font-size:14px; letter-spacing:.04em; }

    @media (max-width:1080px) { .cat-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } nav.desk a { font-size:10px; gap:2px; } }
    @media (max-width:980px) {
      nav.desk { display:none; }
      .burger { display:grid; }
      .hero-grid, .banner-inner, .contact-card, .value-grid, .foot-inner { grid-template-columns:1fr; }
      .hero-copy { padding:28px 0 8px; }
      .zones { grid-template-columns:1fr 1fr; }
      .foot-inner { text-align:center; justify-items:center; }
      .same { margin:0 auto; }
    }
    @media (max-width:640px) { .cat-grid { grid-template-columns:1fr; } .ctas { flex-direction:column; } .btn-wa, .btn-call { justify-content:center; } }
  
    /* seo-enhance-css */
    .seo-more { margin-top: 1.35rem; }
    .seo-more h2 { font-size: 1.125rem; font-weight: 800; color: var(--navy); margin: 1.1rem 0 .55rem; }
    .seo-more h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin: .9rem 0 .4rem; }
    .seo-more p { margin: .45rem 0; line-height: 1.65; }
    .seo-more .faq details { border-top: 1px solid #edf0f4; padding: .65rem 0; }
    .seo-more .faq summary { font-weight: 700; cursor: pointer; color: var(--navy); }
    .seo-more .faq details p { margin-top: .4rem; color: #374151; }
    .home-seo { background: #f4efe4; padding: 2.4rem 0 2.8rem; }
    .home-seo h2 { font-size: 1.35rem; font-weight: 800; color: var(--navy); margin-bottom: .8rem; }
    .home-seo h3 { font-size: 1.05rem; font-weight: 700; margin: 1rem 0 .4rem; color: var(--navy); }
    .home-seo p { line-height: 1.7; margin: .45rem 0; max-width: 72ch; }
    .home-seo details { background: #fff; border-radius: .7rem; padding: .75rem 1rem; margin: .45rem 0; }
    .home-seo summary { font-weight: 700; cursor: pointer; color: var(--navy); }

  </style>
